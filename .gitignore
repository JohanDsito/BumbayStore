# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# entorno local
.env.local
.env*.local

# datos reales del catalogo (no versionar)
# Las rondas de fotos que vienen de Drive pesan mucho y no son codigo:
# viven solo en tu maquina y su destino final es el Storage de Supabase.
datos/ronda*/
datos/fotos/
datos/productos.csv
datos/productos.borrador.csv

# scripts temporales de depuracion
_*.mjs
