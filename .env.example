# ------------------------------------------------------------------
# Bumbay Tools — variables de entorno
# Copia este archivo como .env.local y completa los valores.
# .env.local NUNCA se sube a git.
# ------------------------------------------------------------------

# --- Marca y contacto ---
# Dominio final del sitio (sin barra al final). En Vercel debe ser el dominio real.
NEXT_PUBLIC_SITE_URL=https://bumbaystore.vercel.app

# Numero de WhatsApp en formato internacional, sin + ni espacios ni guiones.
# Colombia: 57 + numero de 10 digitos. Ejemplo: 573001234567
NEXT_PUBLIC_WHATSAPP=573000000000

NEXT_PUBLIC_EMAIL=ventas@bumbaytools.com
NEXT_PUBLIC_CIUDAD=Pasto
NEXT_PUBLIC_DIRECCION=Pasto, Colombia

# --- Redes sociales (opcionales; si se dejan vacias no se muestran) ---
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_TIKTOK=

# --- Supabase ---
# Panel de Supabase -> Project Settings -> Data API
# Sin estas dos variables el sitio funciona igual, con los datos de src/data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para el script de importacion que corre en tu maquina.
# NO lleva el prefijo NEXT_PUBLIC_ y NUNCA debe subirse a git ni a Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel de administracion ---
# Ultimo tramo de la URL del panel: tudominio.com/acceso/<esto>
# Sin el prefijo NEXT_PUBLIC_ a proposito: asi no viaja al navegador.
# Cambiala cuando quieras; el panel pasa a responder en la nueva al instante.
ADMIN_RUTA=panel-cambia-esto-por-algo-tuyo

# --- Solo para trabajar en tu equipo ---
# Con CATALOGO=ejemplo la tienda muestra los datos locales más dos nichos de
# EJEMPLO (src/data/ejemplo.seed.ts), aunque haya Supabase configurado.
# Sirve para ver la tienda con varias líneas. Nunca la pongas en Vercel.
# CATALOGO=ejemplo
# Con CATALOGO=demo se ve tu catálogo real de Supabase más los nichos de
# ejemplo, con una franja que avisa que es una demostración.
# CATALOGO=demo
